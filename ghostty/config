font-size = 20
# Disable Ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig
# Change font
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font Bold
# theme
theme = catppuccin-mocha.conf
# window styles
window-padding-x = 2
window-padding-y = 2
mouse-hide-while-typing = true
background-opacity = 1

