font-size = 16
# Disable Ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig
# Change font
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
# theme
theme = Nord
# window styles
window-padding-x = 2
window-padding-y = 2
macos-window-buttons = hidden
window-decoration = none
background-opacity = 1

